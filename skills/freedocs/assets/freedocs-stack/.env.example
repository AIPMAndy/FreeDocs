# Run scripts/prepare.sh. Never commit the generated .env.
OUTLINE_IMAGE=outlinewiki/outline:1.9.2
POSTGRES_IMAGE=postgres:18.4-alpine
REDIS_IMAGE=redis:8.10.0-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
DEX_IMAGE=ghcr.io/dexidp/dex:v2.45.1

OUTLINE_HOST_PORT=3100
DEX_HOST_PORT=5556
MINIO_API_HOST_PORT=31900
MINIO_CONSOLE_HOST_PORT=31901

FREEDOCS_DOMAIN=kb.example.com
URL=https://kb.example.com
PORT=3000
SECRET_KEY=GENERATE_ME
UTILS_SECRET=GENERATE_ME

POSTGRES_USER=outline
POSTGRES_DB=outline
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgres://outline:GENERATE_ME@postgres:5432/outline
PGSSLMODE=disable

REDIS_URL=redis://redis:6379

FILE_STORAGE=s3
MINIO_ROOT_USER=GENERATE_ME
MINIO_ROOT_PASSWORD=GENERATE_ME
AWS_ACCESS_KEY_ID=GENERATE_ME
AWS_SECRET_ACCESS_KEY=GENERATE_ME
AWS_REGION=us-east-1
# Browser-facing base URL. Never change this to http://minio:9000.
AWS_S3_UPLOAD_BUCKET_URL=https://kb.example.com
AWS_S3_UPLOAD_BUCKET_NAME=freedocs-assets
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private

OIDC_CLIENT_ID=freedocs
OIDC_CLIENT_SECRET=GENERATE_ME
OIDC_AUTH_URI=https://kb.example.com/dex/auth
OIDC_TOKEN_URI=http://dex:5556/dex/token
OIDC_USERINFO_URI=http://dex:5556/dex/userinfo
OIDC_LOGOUT_URI=https://kb.example.com
OIDC_DISPLAY_NAME=FreeDocs Login
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
DEX_ISSUER_URL=https://kb.example.com/dex
OUTLINE_OIDC_CALLBACK_URL=https://kb.example.com/auth/oidc.callback

DEX_STATIC_EMAIL=owner@example.com
DEX_STATIC_USERNAME=owner
DEX_STATIC_USER_ID=GENERATE_ME
DEX_STATIC_PASSWORD_HASH=GENERATE_ME

ENABLE_UPDATES=false
LOG_LEVEL=info
DEBUG=
